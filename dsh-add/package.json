{
  "name": "dsh-add",
  "version": "0.1.0",
  "description": "Install a DeepSeek Harness plugin by name — resolves community plugin names against the awesome-dsh-plugin registry, disambiguates collisions, then installs through 'dsh plugin add'.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "dsh-add": "./src/cli.mjs"
  },
  "main": "./src/cli.mjs",
  "exports": {
    ".": "./src/cli.mjs",
    "./match": "./src/match.mjs",
    "./registry": "./src/registry.mjs"
  },
  "files": [
    "src/",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node test/resolve.test.mjs"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "plugin-manager",
    "cli"
  ],
  "author": "tensi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikenainanodesu/Dshka.git",
    "directory": "dsh-add"
  },
  "publishConfig": {
    "access": "public"
  }
}
